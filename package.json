{
  "name": "learnverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LEARNVERSE - an explorable learning world for 5th-6th graders, with a hand-tracked interactive fractions lesson.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tfeng12753/curiocity.git"
  },
  "license": "ISC",
  "scripts": {
    "dev": "npm run sync:wasm && vite",
    "dev:voice": "node --env-file=server/.env server/index.mjs",
    "build": "npm run sync:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "node scripts/sync-mediapipe-wasm.mjs",
    "postinstall": "node scripts/sync-mediapipe-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
