# Copy to server/.env for local dev (never commit the real file).

# Required for narration (/api/speak) - from your ElevenLabs account.
ELEVENLABS_API_KEY=

# Optional - defaults to Elli, a bright young female voice, if unset.
# Pick any voice from your ElevenLabs Voice Library and paste its ID here.
ELEVENLABS_VOICE_ID=

# Optional - how Curio delivers her lines. Both 0-1.
#   STABILITY lower  = more expressive and varied, higher = flatter and safer
#   STYLE     higher = more exaggerated character (above ~0.5 gets unstable)
# Defaults are 0.35 / 0.35, tuned for cheerful rather than neutral.
ELEVENLABS_STABILITY=
ELEVENLABS_STYLE=

# Required for Curio's AI hints (/api/hint) - from your IFM account.
IFM_API_KEY=

# Optional - defaults to IFM/K2-Horizon-375B-A23B if unset.
IFM_MODEL=

# Optional - restrict CORS to the deployed static site. Defaults to "*".
ALLOWED_ORIGIN=http://localhost:5173
